rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function hasProfile(profile) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && userDoc().perfil == profile;
    }

    function isProfessor() {
      return hasProfile('professor');
    }

    function isAluno() {
      return hasProfile('aluno');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function keepsUserIdentity() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
    }

    match /usuarios/{userId} {
      allow read: if isProfessor() || isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.perfil == 'aluno';
      allow update: if isProfessor()
        || (isOwner(userId)
          && request.resource.data.perfil == resource.data.perfil
          && keepsUserIdentity());
      allow delete: if false;
    }

    match /acervo/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isProfessor();
    }

    match /reservas/{document} {
      allow read: if isProfessor()
        || (isAuthenticated() && isOwner(resource.data.usuarioId));
      allow create: if isAluno()
        && isOwner(request.resource.data.usuarioId)
        && request.resource.data.status == 'PENDENTE';
      allow update: if isProfessor()
        || (isOwner(resource.data.usuarioId)
          && request.resource.data.usuarioId == resource.data.usuarioId);
      allow delete: if false;
    }

    match /emprestimos/{document} {
      allow read: if isProfessor()
        || (isAuthenticated() && isOwner(resource.data.usuarioId));
      allow create: if isProfessor();
      allow update: if isProfessor()
        || (isOwner(resource.data.usuarioId)
          && request.resource.data.usuarioId == resource.data.usuarioId);
      allow delete: if false;
    }

    match /notificacoes/{document} {
      allow read: if isAuthenticated() && isOwner(resource.data.usuarioId);
      allow create: if isProfessor();
      allow update: if isAuthenticated()
        && isOwner(resource.data.usuarioId)
        && request.resource.data.usuarioId == resource.data.usuarioId;
      allow delete: if isAuthenticated() && isOwner(resource.data.usuarioId);
    }

    match /logs/{document} {
      allow read, create: if isProfessor();
      allow update, delete: if false;
    }

    // Fail closed: collections not explicitly declared above are denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
